<mxCell id="table_role" value="&lt;div style=&quot;font-size:14px;font-weight:bold;&quot;&gt;role&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;role_id : SERIAL [PK]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;role_name : VARCHAR(30) [NOT NULL, UNIQUE]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;description : TEXT [NULL]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="320" height="145" as="geometry"/></mxCell>
