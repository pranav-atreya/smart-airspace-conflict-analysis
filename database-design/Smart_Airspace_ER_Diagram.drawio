<mxCell id="table_flight" value="&lt;div style=&quot;font-size:14px;font-weight:bold;&quot;&gt;flight&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;flight_id : SERIAL [PK]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;flight_number : VARCHAR(20) [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;aircraft_id : INTEGER [FK → aircraft.aircraft_id]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;departure_airport : INTEGER [FK → airport.airport_id]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;arrival_airport : INTEGER [FK → airport.airport_id]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;scheduled_departure : TIMESTAMP [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;scheduled_arrival : TIMESTAMP [NOT NULL, after departure]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;actual_departure : TIMESTAMP [NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;actual_arrival : TIMESTAMP [NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;status : VARCHAR(20) [SCHEDULED / ACTIVE / COMPLETED / CANCELLED]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1130" y="30" width="320" height="226" as="geometry"/></mxCell>
<mxCell id="table_airport" value="&lt;div style=&quot;font-size:14px;font-weight:bold;&quot;&gt;airport&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;airport_id : SERIAL [PK]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;iata_code : VARCHAR(10) [UNIQUE]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;icao_code : VARCHAR(10) [UNIQUE]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;airport_name : VARCHAR(150) [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;city : VARCHAR(100) [NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;country : VARCHAR(100) [NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;latitude : NUMERIC(8,5) [CHECK -90 to 90 when supplied]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;longitude : NUMERIC(8,5) [CHECK -180 to 180 when supplied]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="table_waypoint" value="&lt;div style=&quot;font-size:14px;font-weight:bold;&quot;&gt;waypoint&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;waypoint_id : SERIAL [PK]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;waypoint_code : VARCHAR(30) [NOT NULL, UNIQUE]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;latitude : NUMERIC(8,5) [NOT NULL, CHECK -90 to 90]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;longitude : NUMERIC(8,5) [NOT NULL, CHECK -180 to 180]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="390" y="350" width="320" height="145" as="geometry"/></mxCell>
<mxCell id="table_flight_waypoint" value="&lt;div style=&quot;font-size:14px;font-weight:bold;&quot;&gt;flight_waypoint&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;flight_id : INTEGER [PK, FK → flight; ON DELETE CASCADE]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;waypoint_id : INTEGER [PK, FK → waypoint]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;sequence_no : INTEGER [NOT NULL, UNIQUE per flight, &gt; 0]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;planned_altitude_ft : INTEGER [NOT NULL, &gt;= 0]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="350" width="320" height="145" as="geometry"/></mxCell>
<mxCell id="table_flight_position" value="&lt;div style=&quot;font-size:14px;font-weight:bold;&quot;&gt;flight_position&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;position_id : SERIAL [PK]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;flight_id : INTEGER [FK → flight.flight_id]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;recorded_at : TIMESTAMP [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;latitude : NUMERIC(8,5) [NOT NULL, CHECK -90 to 90]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;longitude : NUMERIC(8,5) [NOT NULL, CHECK -180 to 180]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;altitude_ft : INTEGER [NOT NULL, &gt;= 0]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;ground_speed_kts : NUMERIC(7,2) [NULL, &gt;= 0]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;heading_deg : NUMERIC(6,2) [NULL, 0 to 360]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1130" y="350" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="table_restricted_airspace" value="&lt;div style=&quot;font-size:14px;font-weight:bold;&quot;&gt;restricted_airspace&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;airspace_id : SERIAL [PK]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;airspace_code : VARCHAR(30) [NOT NULL, UNIQUE]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;airspace_name : VARCHAR(150) [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;restriction_type : VARCHAR(30) [RESTRICTED / PROHIBITED / DANGER]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;center_latitude : NUMERIC(8,5) [NOT NULL, valid latitude]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;center_longitude : NUMERIC(8,5) [NOT NULL, valid longitude]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;radius_nm : NUMERIC(8,2) [NOT NULL, &gt; 0]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;lower_altitude_ft : INTEGER [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;upper_altitude_ft : INTEGER [NOT NULL, &gt;= lower altitude]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;valid_from : TIMESTAMP [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;valid_to : TIMESTAMP [NOT NULL, after valid_from]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="320" height="244" as="geometry"/></mxCell>
<mxCell id="table_notam" value="&lt;div style=&quot;font-size:14px;font-weight:bold;&quot;&gt;notam&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;notam_id : SERIAL [PK]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;notam_number : VARCHAR(50) [NOT NULL, UNIQUE]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;airspace_id : INTEGER [FK → restricted_airspace]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;title : VARCHAR(200) [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;notam_text : TEXT [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;issued_at : TIMESTAMP [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;effective_from : TIMESTAMP [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;effective_to : TIMESTAMP [NOT NULL, after effective_from]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;status : VARCHAR(20) [ACTIVE / EXPIRED]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;embedding : VECTOR(384) [pgvector embedding, nullable]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;embedding_model : VARCHAR(100) [Model metadata, nullable]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;embedding_generated_at : TIMESTAMP [Generation timestamp, nullable]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="390" y="650" width="320" height="262" as="geometry"/></mxCell>
<mxCell id="table_incident" value="&lt;div style=&quot;font-size:14px;font-weight:bold;&quot;&gt;incident&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;incident_id : SERIAL [PK]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;flight_id : INTEGER [FK → flight.flight_id]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;incident_type : VARCHAR(40) [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;incident_title : VARCHAR(200) [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;description : TEXT [NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;occurred_at : TIMESTAMP [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;severity : VARCHAR(20) [LOW / MEDIUM / HIGH / CRITICAL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;embedding : VECTOR(384) [pgvector embedding, nullable]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;embedding_model : VARCHAR(100) [Model metadata, nullable]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;embedding_generated_at : TIMESTAMP [Generation timestamp, nullable]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="650" width="320" height="226" as="geometry"/></mxCell>
<mxCell id="table_conflict_event" value="&lt;div style=&quot;font-size:14px;font-weight:bold;&quot;&gt;conflict_event&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;conflict_id : SERIAL [PK]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;primary_flight_id : INTEGER [FK → flight.flight_id]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;secondary_flight_id : INTEGER [Nullable FK → flight.flight_id]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;airspace_id : INTEGER [Nullable FK → restricted_airspace]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;detected_at : TIMESTAMP [NOT NULL, DEFAULT CURRENT_TIMESTAMP]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;conflict_type : VARCHAR(40) [NOT NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;severity : VARCHAR(20) [LOW / MEDIUM / HIGH / CRITICAL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;description : TEXT [NULL]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;minimum_distance_nm : NUMERIC(8,3) [NULL, &gt;= 0]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;altitude_difference_ft : INTEGER [NULL, &gt;= 0]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;resolved : BOOLEAN [NOT NULL, DEFAULT FALSE]&lt;/div&gt;&lt;div style=&quot;font-size:10px;&quot;&gt;resolved_at : TIMESTAMP [NULL; maintained by trigger]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#60a5fa;fontColor=#e2e8f0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1130" y="650" width="320" height="262" as="geometry"/></mxCell>
</root>
    </mxGraphModel>
